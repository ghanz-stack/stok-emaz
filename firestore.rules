// RULES GABUNGAN — paste ke console.firebase.google.com → project budget-b8b49
// → Firestore Database → Rules → Publish.
//
// BudgetRumah (dokumen budgets/{kode}) + App Stok G24 Kedaton
// (mutasi/sessions/logs/users/master/backups) hidup berdampingan,
// keduanya tanpa Firebase Auth (PIN lokal di app).
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /budgets/{d}   { allow read, write: if true; }
    match /mutasi/{d}    { allow read, write: if true; }
    match /sessions/{d}  { allow read, write: if true; }
    match /logs/{d}      { allow read, write: if true; }
    match /users/{d}     { allow read, write: if true; }
    match /master/{d}    { allow read, write: if true; }
    match /backups/{d}   { allow read, write: if true; }
  }
}
