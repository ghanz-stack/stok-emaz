rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Semua user full akses (sesuai keputusan), tapi wajib login.
    // Hapus fisik ditolak dari client — gunakan Void/status, biar tercatat di Log.
    function authed() { return request.auth != null; }
    match /mutasi/{d}   { allow read: if authed(); allow create, update: if authed(); allow delete: if false; }
    match /sessions/{d} { allow read: if authed(); allow create, update: if authed(); allow delete: if false; }
    match /logs/{d}     { allow read: if authed(); allow create: if authed(); allow update, delete: if false; }
    match /users/{d}    { allow read: if authed(); allow create, update: if authed(); allow delete: if false; }
  }
}
