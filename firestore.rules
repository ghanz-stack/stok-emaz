// RULES — paste ke console.firebase.google.com → project G24 Kedaton
// → Firestore Database → Rules → Publish.
//
// MODEL B: koleksi movements + balances + sessions + logs + users + master + settings + backups.
// App tidak pakai Firebase Auth (login PIN lokal), jadi koleksi dibuka tanpa auth.
// delete diizinkan karena: Reset Semua Data (ADMIN), hapus Master, hapus User.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /movements/{d} { allow read, create, update, delete: if true; }
    match /balances/{d}  { allow read, create, update, delete: if true; }
    match /sessions/{d}  { allow read, create, update, delete: if true; }
    match /logs/{d}      { allow read, create, update, delete: if true; }
    match /users/{d}     { allow read, create, update, delete: if true; }
    match /master/{d}    { allow read, create, update, delete: if true; }
    match /settings/{d}  { allow read, create, update, delete: if true; }
    match /backups/{d}   { allow read, create, update, delete: if true; }
  }
}
