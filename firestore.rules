// RULES — paste ke console.firebase.google.com → project BARU G24 Kedaton
// → Firestore Database → Rules → Publish.
//
// App tidak pakai Firebase Auth (login PIN lokal), jadi koleksi dibuka
// tanpa auth. Hapus fisik dari client ditolak — pakai Void/status + Log.
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    match /mutasi/{d}    { allow read: if true; allow create, update: if true; allow delete: if false; }
    match /sessions/{d}  { allow read: if true; allow create, update: if true; allow delete: if false; }
    match /logs/{d}      { allow read: if true; allow create: if true; allow update, delete: if false; }
    match /users/{d}     { allow read: if true; allow create, update: if true; allow delete: if false; }
    match /master/{d}    { allow read: if true; allow create, update: if true; allow delete: if false; }
    match /backups/{d}   { allow read: if true; allow create: if true; allow update, delete: if false; }
  }
}
